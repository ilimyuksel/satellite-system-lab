##include "orbit/include/Orbit.hh"
##include "system/include/Spacecraft.hh"
##include "trick/exec_proto.h"
class SatelliteSimObject : public Trick::SimObject {
public:
    Orbit satellite;
    Spacecraft spacecraft;
    SatelliteSimObject() {
        ("default_data") satellite.default_data();
        ("default_data") spacecraft.default_data();
        ("initialization") satellite.initialize();
        ("initialization") spacecraft.initialize(satellite.illumination, satellite.sun_distance);
        ("derivative") satellite.derivatives();
        ("integration") trick_ret = satellite.integrate_state();
        (1.0, "scheduled") satellite.diagnostics();
        (1.0, "scheduled") spacecraft.step(exec_get_sim_time(), satellite.illumination, satellite.sun_distance);
    }
};
SatelliteSimObject dyn;
IntegLoop dyn_integloop(1.0) dyn;
